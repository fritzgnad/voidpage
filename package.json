{
  "name": "voidpage",
  "version": "1.0.4",
  "description": "A minimal, distraction-free Markdown editor built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "productName": "VoidPage",
  "keywords": [
    "electron",
    "markdown",
    "writer",
    "minimal",
    "void",
    "page"
  ],
  "author": "fritzgnad",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/fritzgnad/voidpage.git"
  },
  "bugs": {
    "url": "https://github.com/fritzgnad/voidpage/issues"
  },
  "homepage": "https://github.com/fritzgnad/voidpage#readme",
  "build": {
    "appId": "com.voidpage.app",
    "productName": "VoidPage",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "voidpage_logo.png",
      "hardenedRuntime": true,
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1"
  }
}
